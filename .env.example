# =============================================================================
# NOVA 环境变量示例
# =============================================================================
# 用法：
#   cp .env.example .env      然后按注释填值
#
# 说明：
#   - .env 只在本地生效，已加入 .gitignore，**不要提交**。
#     本文件（.env.example）里只有占位符，不含任何真实密钥，必须提交。
#   - 加载优先级：**进程里已存在的环境变量 > .env 文件 > config.yaml 的字面默认值**。
#     CI / 生产环境直接注入同名变量即可，不需要 .env。
#   - 变量全部以 NOVA_ 前缀命名，与 config.yaml 中的 ${...} 插值一一对应。
#     改名必须同时改 config.yaml 与本文件，否则 npm run config:check 会报错。
#   - 标注「必填」的变量缺失时，npm run config:check / 服务启动会直接失败并点名。
#     其余变量都有默认值，可以不写。
# =============================================================================

# -----------------------------------------------------------------------------
# 控制台（Next.js）
# -----------------------------------------------------------------------------

# 应用监听端口。默认 3234。可选
NOVA_DEV_PORT=3234

# 监听地址。默认 0.0.0.0（局域网可访问）；只限本机改为 127.0.0.1。可选
NOVA_DEV_HOSTNAME=0.0.0.0

# 运行环境：development | test | production。默认 development。可选
# 发布脚本构建时会写成 production。
NOVA_ENV=development

# -----------------------------------------------------------------------------
# 本地 Agent（playground/nova-local）
# -----------------------------------------------------------------------------

# Agent 名称，同时是 playground/<name> 的目录名。默认 nova-local。可选
NOVA_AGENT_NAME=nova-local

# 模型标识。可选
# 必须与 Agent 端点 GET /v1/models 返回的 id 完全一致，否则沙盒投放会报
# 「模型服务返回 404」这类协议不匹配错误。
NOVA_AGENT_MODEL=nova-local-agent

# Agent 监听端口。默认 43110。可选
# 端口被占用时改这里，不必改代码（入口会读该变量）。
NOVA_AGENT_PORT=43110

# Agent 监听地址。默认 127.0.0.1（只对本机暴露）。可选
# 容器里部署给别人访问时才需要改成 0.0.0.0，并自行评估暴露面。
NOVA_AGENT_HOSTNAME=127.0.0.1

# 以下三个变量来自 playground/nova-local/agent.config.yaml，
# 用于单独调这个 Agent 的预算做对照实验。全部可选。

# 轮次预算：留两轮给压缩与交卷。默认 6。可选
NOVA_AGENT_ROUND_BUDGET=6

# 检索尝试上限：超过就降级交卷。默认 5。可选
NOVA_AGENT_MAX_SEARCH_ATTEMPTS=5

# 交叉验证要求的独立来源数，达不到即判单源降级。默认 2。可选
NOVA_AGENT_REQUIRED_SOURCES=2

# -----------------------------------------------------------------------------
# 外部大语言模型端点（可选）
# -----------------------------------------------------------------------------
# 以下四个变量**只在把 NOVA 指向真实模型服务（Ollama / vLLM / LM Studio /
# 各类兼容网关）时才需要**。使用仓库自带的 playground/nova-local 执行体时
# 无需填写 —— 它不依赖任何模型服务。

# OpenAI 兼容端点根地址。可选（默认指向本地执行体 43110）
# 形如 http://127.0.0.1:11434/v1：必须带 /v1，且不带末尾斜杠。
NOVA_LLM_BASE_URL=http://127.0.0.1:43110/v1

# 端点上的模型标识，与 /v1/models 里的 id 一致。可选
NOVA_LLM_MODEL=nova-local-agent

# 单次补全的 max_tokens 上限。默认 2000。可选
# 单请求耗时接近 120s 上限时，把这里调小。
NOVA_LLM_MAX_TOKENS=2000

# 单次模型调用超时（毫秒）。默认 30000。可选
NOVA_LLM_TIMEOUT_MS=30000

# 请求密钥。**敏感值，只写在这里，绝不要写进 config.yaml 或代码**。可选
# 无鉴权的本地端点（Ollama 等）留空即可：留空时不会发送 Authorization 头。
# 示例值不是真实密钥，请替换成你自己的。
NOVA_LLM_API_KEY=replace-with-your-api-key-or-leave-empty

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------

# 日志级别：debug | info | warn | error。默认 info。可选
NOVA_LOG_LEVEL=info

# 是否在日志里回显请求体。默认 false。可选
# 打开会记录系统提示词与工具返回内容，排查协议问题时有用，
# 但可能把敏感内容写进日志，**生产环境务必保持 false**。
NOVA_LOG_ECHO_PAYLOAD=false

# -----------------------------------------------------------------------------
# 测试
# -----------------------------------------------------------------------------

# 集成测试访问的 NOVA 基地址。默认 http://127.0.0.1:3234。可选
# npm run test:e2e 会先探测该地址，连不上就自动拉起 dev server。
NOVA_TEST_BASE_URL=http://127.0.0.1:3234

# -----------------------------------------------------------------------------
# 发布
# -----------------------------------------------------------------------------

# 是否在 publish 阶段创建 GitHub Release 与 tag。默认 true。可选
# 只想本地打产物、不想动远端时设为 false。
NOVA_RELEASE_GITHUB=true

# GitHub 令牌。**敏感值**。可选
# 仅当 publish 需要鉴权且本机 gh 未登录时才需要（脚本默认复用 gh 的登录态）。
NOVA_GITHUB_TOKEN=replace-with-your-github-token-or-leave-empty
