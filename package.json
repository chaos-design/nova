{
  "name": "@chaos-design/nova",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA monorepo 根（Next-gen Operational Verification for Agents）",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chaos-design/web dev",
    "dev:agent": "pnpm --filter @chaos-design/nova-local start",
    "agent:local": "pnpm run dev:agent",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "pnpm --filter @chaos-design/web build",
    "start": "pnpm --filter @chaos-design/web start",
    "config:check": "node scripts/check-config.mjs",

    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter @chaos-design/web typecheck",
    "check": "pnpm run typecheck && pnpm run lint",

    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @chaos-design/web test:integration",
    "test:e2e": "node scripts/e2e.mjs",
    "test:watch": "pnpm --filter @chaos-design/web test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "test:all": "pnpm run test && pnpm run test:e2e",

    "release:check": "node scripts/release/check.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:build": "node scripts/release/build.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release": "node scripts/release/index.mjs"
  },
  "dependencies": {
    "@chaos-design/config": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
